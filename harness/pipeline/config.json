{
  "schema": 1,
  "mode": "full_auto",
  "roadmap": "Docs/ROADMAP.md",
  "max_iterations": 3,
  "branch_prefix": "codex/auto",
  "generator": {
    "model": "gpt-5.6-sol",
    "timeout_seconds": 7200
  },
  "evaluator": {
    "model": "sonnet",
    "timeout_seconds": 3600
  },
  "publish": {
    "enabled": true,
    "remote": "origin",
    "base_branch": "main",
    "auto_merge": true,
    "merge_method": "squash"
  },
  "protected_prefixes": [
    ".github/workflows/",
    "harness/pipeline/",
    "harness/schemas/",
    "AGENTS.md",
    "Tools/check_roadmap.ps1",
    "Assets/Vendor/",
    "Assets/URP GanzSe Free Modular Character Pack/",
    "Assets/DoubleL/"
  ],
  "production_prefixes": [
    "Assets/",
    "Packages/",
    "ProjectSettings/",
    "Tools/"
  ],
  "required_docs_for_production": [
    "Docs/ROADMAP.md",
    "Docs/PROTOTYPE_STATUS.md",
    "Docs/VALIDATION.md"
  ]
}
